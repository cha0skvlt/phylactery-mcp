# The server reads the AOE registry by default:
#   ~/.config/cha0s/settings.json -> agent.databases.phylactery.dsn
#   ~/.config/cha0s/settings.json -> language_models.ollama.api_url
#
# Nothing here is required when the registry is present. These variables override it.

PHYLACTERY_DSN=
PHYLACTERY_ADMIN_DSN=

# Embeddings. The server computes no vectors itself: it asks an endpoint for them.
#   ollama -> POST {url}/api/embed        {"embeddings": [[...]]}
#   openai -> POST {url}/v1/embeddings    {"data": [{"embedding": [...]}]}
# A base that already ends in /v1 is not doubled.
PHYLACTERY_EMBED_API=ollama
PHYLACTERY_EMBED_URL=http://127.0.0.1:11434
PHYLACTERY_EMBED_MODEL=nomic-embed-text-v2-moe
# Bearer token for a cloud endpoint. Leave empty for a local one.
PHYLACTERY_EMBED_API_KEY=

# Legacy alias for PHYLACTERY_EMBED_URL. Kept so an existing setup does not break.
PHYLACTERY_OLLAMA_URL=http://127.0.0.1:11434

PHYLACTERY_AGENT_ID=agent
PHYLACTERY_BACKUP_DIR=backups
PHYLACTERY_MIGRATIONS_DIR=migrations

# Graph covers memory written after this timestamp (RFC 3339). Empty means all of it.
PHYLACTERY_KG_SINCE=

PHYLACTERY_POOL_MAX=8
PHYLACTERY_STATEMENT_TIMEOUT_MS=10000
PHYLACTERY_LOG=info
